{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/tr/:path*",
      "destination": "https://translate.googleapis.com/:path*"
    },
    {
      "source": "/api/ms/:path*",
      "destination": "https://www.motorsport.com/rss/:path*/"
    },
    {
      "source": "/api/as/:path*",
      "destination": "https://www.autosport.com/rss/:path*/"
    },
    {
      "source": "/api/cr/:path*",
      "destination": "https://www.crash.net/rss/:path*"
    },
    {
      "source": "/api/yt/:path*",
      "destination": "https://www.youtube.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/cards.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 0 * * *"
    }
  ]
}
